{
  "manifest_version": 3,
  "name": "Crunchyroll Auto Skip",
  "version": "1.3.0",
  "description": "Skip recaps, intros, outros and previews on Crunchyroll.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://crunchyroll.com/*",
    "https://static.crunchyroll.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crunchyroll Auto Skip"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://crunchyroll.com/*",
        "https://static.crunchyroll.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}